FROM node:22-bookworm-slim

# Enable pnpm via corepack as root (needs to write to /usr/local/bin)
RUN corepack enable pnpm

# Set working directory inside the container and ensure ownership
WORKDIR /var/www/html
RUN chown -R node:node /var/www/html

# Switch to non-root node user
USER node

# Copy package descriptors first to leverage Docker layer caching
# .npmrc includes only-built-dependencies=@parcel/watcher (no workspace file needed)
COPY --chown=node:node package.json pnpm-lock.yaml .npmrc pnpm-workspace.yaml ./

# Install dependencies using pnpm
RUN pnpm install --frozen-lockfile

# Copy complete source code
COPY --chown=node:node . .

# Expose port for development hot-reloading
EXPOSE 5173

# Switch back to root to allow runtime volume chown before dropping privileges
USER root

# Start the Vite development hot-reloading dev-server
CMD ["pnpm", "run", "dev"]


