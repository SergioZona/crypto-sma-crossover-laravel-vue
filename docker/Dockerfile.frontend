FROM node:22-bookworm-slim

# Enable pnpm via corepack as root (needs to write to /usr/local/bin)
RUN corepack enable pnpm

# Set working directory inside the container and ensure ownership
WORKDIR /var/www/html
RUN chown -R node:node /var/www/html

# Copy package descriptors first to leverage Docker layer caching (read-only for node)
COPY package.json pnpm-lock.yaml .npmrc pnpm-workspace.yaml ./

# Switch to non-root node user for package installation
USER node

# Install dependencies using pnpm
RUN pnpm install --frozen-lockfile

# Switch to root to copy source files safely with read-only permissions for node
USER root
COPY src ./src
COPY public ./public
COPY tsconfig.json vite.config.ts index.html ./

# Switch back to non-root node user for safe container execution
USER node

# Expose port for development hot-reloading
EXPOSE 5173

# Start the Vite development hot-reloading dev-server
CMD ["pnpm", "run", "dev"]
